<script>
    /* ====== TABS LEVEL 1 (Tab 1 / Tab 2 / Tab 3) ====== */
    const mainTabs = document.querySelectorAll(".tab-btn");
    const mainContents = document.querySelectorAll(".tab-content[id^='tab']");

    mainTabs.forEach(btn => {
        btn.addEventListener("click", () => {
            mainTabs.forEach(b => b.classList.remove("active"));
            mainContents.forEach(c => c.classList.remove("active"));

            btn.classList.add("active");
            document.getElementById(btn.dataset.tab).classList.add("active");
        });
    });

    /* ====== TABS LEVEL 2 (أذكار) ====== */
    const azkarTabs = document.querySelectorAll(".tab-link");
    const azkarContents = document.querySelectorAll("#sabah, #masaa, #sleep, #ruqya");

    azkarTabs.forEach(btn => {
        btn.addEventListener("click", () => {
            azkarTabs.forEach(b => b.classList.remove("active"));
            azkarContents.forEach(c => c.classList.add("hidden"));

            btn.classList.add("active");
            document.getElementById(btn.dataset.tab).classList.remove("hidden");
            window.scrollTo({ top: 0, behavior: "smooth" });
        });
    });

    /* ====== DARK MODE ====== */
    const toggleBtn = document.getElementById("toggle-mode");
    if (toggleBtn) {
        toggleBtn.addEventListener("click", () => {
            document.body.classList.toggle("dark");
            localStorage.setItem("darkMode", document.body.classList.contains("dark"));
        });

        if (localStorage.getItem("darkMode") === "true") {
            document.body.classList.add("dark");
        }
    }

    document.querySelectorAll('.counter').forEach(counter => {
        const minusBtn = counter.querySelector('.minus');
        const plusBtn = counter.querySelector('.plus');
        const countSpan = counter.querySelector('.count');
        const max = parseInt(counter.dataset.max, 10);

        let count = 0;

        plusBtn.addEventListener('click', () => {
            if (count < max) {
                count++;
                countSpan.textContent = count;
                if(count === max){
                    counter.parentElement.classList.add('completed'); // يجعل الصندوق شفاف عند الاكتمال
                }
            }
        });

        minusBtn.addEventListener('click', () => {
            if (count > 0) {
                count--;
                countSpan.textContent = count;
                counter.parentElement.classList.remove('completed');
            }
        });
    });

</script>